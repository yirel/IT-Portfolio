print("=== Student Grade Classifier ===")

student_name = input("Enter the student's name: ")

quiz_score = float(input("Enter the quiz score: "))
activity_score = float(input("Enter the activity score: "))
exam_score = float(input("Enter the examination score: "))
attendance = float(input("Enter attendance percentage: "))

scores_are_valid = (
    0 <= quiz_score <= 100
    and 0 <= activity_score <= 100
    and 0 <= exam_score <= 100
    and 0 <= attendance <= 100
)

if scores_are_valid:
    final_grade = (
        quiz_score * 0.30
        + activity_score * 0.30
        + exam_score * 0.40
    )

    if final_grade >= 90:
        performance = "Excellent"
    elif final_grade >= 85:
        performance = "Very Good"
    elif final_grade >= 80:
        performance = "Good"
    elif final_grade >= 75:
        performance = "Satisfactory"
    else:
        performance = "Needs Improvement"

    if final_grade >= 75:
        result = "Passed"
    else:
        result = "Failed"

    if final_grade >= 98:
        distinction = "With Highest Honors"
    elif final_grade >= 95:
        distinction = "With High Honors"
    elif final_grade >= 90:
        distinction = "With Honors"
    else:
        distinction = "No Academic Distinction"
    if final_grade < 75 and attendance < 80:
        reason = "Low grade and insufficient attendance"
    elif final_grade < 75:
        reason = "Final grade is below 75"
    elif attendance < 80:
        reason = "Attendance is below 80%"
    else:
        reason = "All requirements satisfied"
        
    print("\n=== Grade Report ===")
    print(f"Student: {student_name}")
    print(f"Quiz Score: {quiz_score:.2f}")
    print(f"Activity Score: {activity_score:.2f}")
    print(f"Examination Score: {exam_score:.2f}")
    print(f"Final Grade: {final_grade:.2f}")
    print(f"Attendance: {attendance:.2f}%")
    print(f"Performance: {performance}")
    print(f"Result: {result}")
    print(f"Academic Distinction: {distinction}")
    print(f"Reason: {reason}")
else:
    print("\nError: Quiz, Activity, Examination, and Attendance must all be between 0 and 100.")